{
  "name": "toolencahnt-mobile",
  "version": "1.0.0",
  "description": "Toolencahnt - Mobile App with React Native",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build-android": "cd android && ./gradlew assembleRelease",
    "build-apk": "cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../Toolencahnt-release.apk",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "tools",
    "toolkit",
    "mobile",
    "react-native"
  ],
  "author": "streakmacro-coder",
  "license": "MIT",
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",
    "@react-native-community/hooks": "^3.0.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "@react-native/eslint-config": "^0.72.0",
    "babel-jest": "^29.2.1",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.76.0",
    "react-test-renderer": "18.2.0"
  }
}
